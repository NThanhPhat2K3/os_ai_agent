  const el = (t, a) => { const e = document.createElementNS(ns, t); for (const k in a) e.setAttribute(k, a[k]); svg.append(e); return e; };
  for (let i = 0; i <= 4; i++) { const y = pad + (H - pad) * i / 4; el('line', {x1: 40, x2: W, y1: y, y2: y, stroke: 'var(--line)'});
    el('text', {x: 0, y: y + 4, fill: 'var(--mut)', 'font-size': 10}).textContent = fmt(max * (1 - i / 4)); }
  const bw = (W - 50) / T.days.length;
  T.days.forEach((d, i) => { const x = 46 + i * bw, c = (d.claude || {}).totalTokens || 0, k = (d.codex || {}).totalTokens || 0;
    const hc = (H - pad) * c / max, hk = (H - pad) * k / max;
    const g1 = el('rect', {x, y: H - hc, width: bw * .7, height: hc, rx: 3, fill: 'var(--claude)'});
