    for (const g of [g1, g2]) { const t = document.createElementNS(ns, 'title'); t.textContent = `${d.day}\nClaude: ${fmt(c)}\nCodex: ${fmt(k)}`; g.append(t); }
    if (i % Math.ceil(T.days.length / 10) === 0) el('text', {x, y: H + 16, fill: 'var(--mut)', 'font-size': 10}).textContent = d.day.slice(5); });
  box.append($('h2', {}, 'Token theo ngày'), $('div', {class: 'chart scroll'}, svg,
    $('div', {class: 'legend'}, $('span', {}, $('i', {style: 'background:var(--claude)'}), 'Claude Code'), $('span', {}, $('i', {style: 'background:var(--codex)'}), 'Codex'))));
  box.append($('p', {class: 'muted'}, 'Phần lớn là token đọc từ cache. Số liệu từ ccusage (offline, local). Không hiển thị tiền: giá API ≠ hoá đơn gói đăng ký.')); })();

// ---- Add skill
(() => { const box = document.getElementById('tab-add');
  const sec = (t, ...k) => box.append($('div', {class: 'howto'}, $('h2', {}, t), ...k));
  sec('1. Tìm skill xịn', $('p', {}, 'Nguồn uy tín: ', $('a', {href: 'https://github.com/anthropics/skills', target: '_blank', rel: 'noopener'}, 'anthropics/skills'), ' · ',
