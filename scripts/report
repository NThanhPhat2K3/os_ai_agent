#!/usr/bin/env python3
"""Build a local HTML dashboard (skills, updates, tokens) and open it in the browser.

  scripts/report [--no-network] [--no-open] [--days 30] [--out PATH]

Everything stays on this machine: the page is a single static file with inline CSS/JS
(no CDN, no server). --no-network skips the upstream update check.
"""
import argparse
import html
import json
import os
import re
import subprocess
import sys
import webbrowser
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from tools.skill_hub.catalog import load, skill_dir  # noqa: E402

HOME = Path.home()
ROOTS = {'claude': HOME / '.claude/skills', 'codex': HOME / '.agents/skills',
         'codex-legacy': HOME / '.codex/skills', 'codex-system': HOME / '.codex/skills/.system'}
BIN = HOME / '.local/share/os_ai_agent/node/node_modules/.bin'


def frontmatter(text):
    m = re.match(r'---\n(.*?)\n---', text, re.S)
    out = {}
    if m:
        for line in m.group(1).splitlines():
            if ':' in line and not line.startswith(' '):
                k, v = line.split(':', 1)
                out[k.strip()] = v.strip().strip('"\'')
    return out


def read_skill(path):
    md = Path(path) / 'SKILL.md'
    if not md.is_file():
        return None
    text = md.read_text(encoding='utf-8', errors='replace')
    return text, frontmatter(text)


def git(*args, cwd=ROOT):
    try:
        return subprocess.run(['git', '-C', str(cwd), *args], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ''


def collect_skills():
    data = load()
    out, managed = [], set()
    for item in data['skills']:
        d = skill_dir(data, item)
        got = read_skill(d)
        text, fm = got if got else ('', {})
        vendor = data['vendors'].get(item.get('vendor', ''), {})
        links = {}
        for agent in ('claude', 'codex'):
            p = ROOTS[agent] / item['name']
            links[agent] = p.is_symlink() and p.resolve() == d.resolve()
        out.append({'name': item['name'], 'group': 'managed', 'origin': vendor.get('repo', 'os_ai_agent (tự viết)'),
                    'pin': git('rev-parse', '--short', 'HEAD', cwd=ROOT / vendor['path']) if vendor else
                           git('log', '-1', '--format=%cs', '--', f'skills/{item["name"]}'),
                    'description': fm.get('description', ''), 'text': text, 'claude': links['claude'],
                    'codex': links['codex'], 'ok': bool(got) and all(links.values())})
        managed.add(item['name'])
    for key, root in ROOTS.items():
        if not root.is_dir():
            continue
        for d in sorted(root.iterdir()):
            if d.name.startswith('.') and key != 'codex-system' or d.name in managed:
                continue
            got = read_skill(d)
            if not got:
                continue
            text, fm = got
            agent = 'claude' if key == 'claude' else 'codex'
            out.append({'name': fm.get('name', d.name), 'group': 'builtin' if key == 'codex-system' else 'other',
                        'origin': {'claude': 'Claude (tự cài)', 'codex': 'Codex (tự cài)',
                                   'codex-legacy': 'Codex (~/.codex/skills)', 'codex-system': 'Codex (hệ thống)'}[key],
                        'pin': '', 'description': fm.get('description', ''), 'text': text,
                        'claude': agent == 'claude', 'codex': agent == 'codex', 'ok': True})
    return out


def collect_updates(network):
    if not network:
        return {'skipped': True, 'items': []}
    try:
        from tools.skill_hub.engine import checks
        return {'skipped': False, 'items': sorted(checks(), key=lambda r: r['id'])}
    except Exception as error:  # report must still render offline
        return {'skipped': False, 'items': [], 'error': str(error)}


def ccusage(agent):
    exe = BIN / 'ccusage'
    if not exe.exists():
        return None
    env = {**os.environ, 'DISABLE_TELEMETRY': '1', 'DO_NOT_TRACK': '1'}
    try:
        p = subprocess.run([str(exe), agent, 'daily', '--json', '--offline', '--no-cost'],
                           capture_output=True, text=True, timeout=120, env=env)
        rows = json.loads(p.stdout).get('daily', [])
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    keys = ('inputTokens', 'outputTokens', 'cacheCreationTokens', 'cacheReadTokens', 'totalTokens')
    return [{'day': r.get('period') or r.get('date'), **{k: int(r.get(k, 0) or 0) for k in keys}} for r in rows]


def collect_tokens(days):
    claude, codex = ccusage('claude'), ccusage('codex')
    if claude is None and codex is None:
        return {'available': False}
    by_day = {}
    for agent, rows in (('claude', claude or []), ('codex', codex or [])):
        for r in rows:
            by_day.setdefault(r['day'], {})[agent] = r
    days_sorted = sorted(d for d in by_day if d)[-days:]
    return {'available': True, 'days': [{'day': d, **by_day[d]} for d in days_sorted]}


