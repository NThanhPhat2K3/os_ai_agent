  sec('2. Thử trước (không thay đổi gì)', $('pre', {}, 'scripts/add-skill owner/repo ten-skill --dry-run'),
    $('p', {class: 'muted'}, 'Tự kiểm tra: SKILL.md hợp lệ, trùng tên, phụ thuộc skill chưa bật, có kèm script/code không.'));
  sec('3. Thêm và áp dụng', $('pre', {}, 'scripts/add-skill owner/repo ten-skill\nscripts/doctor.sh\n# nhờ Codex review (ask-codex-live), rồi:\ngit add -A && git commit -m "Add skill ten-skill"\nscripts/install.sh'),
    $('p', {class: 'muted'}, 'Repo mới được pin vào commit ≥14 ngày tuổi. Gỡ: scripts/add-skill --remove ten-skill')); })();
</script></body></html>'''


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument('--no-network', action='store_true')
    ap.add_argument('--no-open', action='store_true')
    ap.add_argument('--days', type=int, default=30)
    ap.add_argument('--out', default=str(HOME / '.cache/os_ai_agent/report.html'))
    args = ap.parse_args()
    data = {'generated': datetime.now(timezone.utc).astimezone().strftime('%Y-%m-%d %H:%M'),
            'skills': collect_skills(), 'updates': collect_updates(not args.no_network),
            'tokens': collect_tokens(args.days)}
    payload = json.dumps(data, ensure_ascii=False).replace('</', '<\\/')   # safe inside <script>
    out = Path(args.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(PAGE.replace('__DATA__', payload), encoding='utf-8')
    os.chmod(out, 0o600)   # contains skill text and usage numbers: keep private
    print(f'Report: {out}')
    if not args.no_open:
        webbrowser.open(out.as_uri())


if __name__ == '__main__':
    main()
