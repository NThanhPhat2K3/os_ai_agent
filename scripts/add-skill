#!/usr/bin/env python3
"""Add (or remove) a third-party skill to the shared catalog, safely.

  scripts/add-skill owner/repo skill-name [--skills-dir skills] [--ref SHA] [--dry-run]
  scripts/add-skill --remove skill-name

Adding:
  1. vendors the repo as a git submodule under vendor/<repo-name> (reused if already there),
  2. pins it to the newest commit that is at least 14 days old (or --ref),
  3. validates SKILL.md (frontmatter name/description, name matches folder),
  4. warns about name clashes, references to skills that are not enabled, and bundled scripts,
  5. adds the skill to skills.json.
It never commits and never installs: review, run scripts/doctor.sh, ask the other agent to
review, commit, then run scripts/install.sh.
"""
import argparse
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
from tools.skill_hub.catalog import NAME, SAFE_DIR, load  # noqa: E402
from tools.skill_hub.engine import choose_commit, github_json  # noqa: E402

REPO = re.compile(r'[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+')
SHA = re.compile(r'[0-9a-f]{40}')


def git(*args, cwd=ROOT):
    return subprocess.run(['git', '-C', str(cwd), *args], check=True, capture_output=True, text=True).stdout.strip()


def frontmatter(text):
    m = re.match(r'---\n(.*?)\n---', text, re.S)
    if not m:
        return {}
    out = {}
    for line in m.group(1).splitlines():
        if ':' in line and not line.startswith(' '):
            k, v = line.split(':', 1)
            out[k.strip()] = v.strip().strip('"\'')
    return out


def save(data):
    tmp = ROOT / 'skills.json.tmp'
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')
    tmp.replace(ROOT / 'skills.json')


def pick_commit(repo, cooldown):
    """Newest commit on the default branch that is at least `cooldown` days old.

    Asks GitHub directly with ?until=<cutoff>, so very active repos (100+ commits in
    the last weeks) still get a correct, old-enough pin.
    """
    from datetime import timedelta
    cutoff = (datetime.now(timezone.utc) - timedelta(days=cooldown)).strftime('%Y-%m-%dT%H:%M:%SZ')
    commits = github_json(f'repos/{repo}/commits?until={cutoff}&per_page=1')
    if not commits:
        sys.exit(f'No commit of {repo} is at least {cooldown} days old; pass --ref explicitly if you accept that.')
    return commits[0]['sha']


def undo_vendor(path):
    """Remove a submodule this run just added, so a failed add leaves no trace.

    Order matters: deinit, drop the gitlink from the index, then the .gitmodules
    section, then the working tree and .git/modules copies.
    """
    if not path:
        return
    import shutil
    run = lambda *a: subprocess.run(['git', '-C', str(ROOT), *a], capture_output=True)
    run('submodule', 'deinit', '-q', '-f', '--', path)
    run('rm', '-q', '--cached', '-f', '--', path)
    run('config', '-f', '.gitmodules', '--remove-section', f'submodule.{path}')
    gm = ROOT / '.gitmodules'
    if gm.exists() and not gm.read_text().strip():
        run('rm', '-q', '-f', '--', '.gitmodules')
    elif gm.exists():
        run('add', '.gitmodules')
    for leftover in (ROOT / path, ROOT / '.git' / 'modules' / path):
        if leftover.exists() and str(leftover.resolve()).startswith(str(ROOT.resolve())):
            shutil.rmtree(leftover)
    print(f'  ↺ removed submodule {path}')


def check_ref_age(repo, ref, cooldown, allow_young):
    try:
        info = github_json(f'repos/{repo}/commits/{ref}')
    except (subprocess.CalledProcessError, OSError, ValueError):
        sys.exit(f'--ref {ref[:7]} not found in {repo}. Nothing was changed.')
    when = datetime.fromisoformat(info['commit']['committer']['date'].replace('Z', '+00:00'))
    age = (datetime.now(timezone.utc) - when).days
    if age < cooldown:
        msg = f'--ref {ref[:7]} is only {age} day(s) old (< {cooldown}).'
        if not allow_young:
            sys.exit(msg + ' Re-run with --allow-young if you accept the risk.')
        print('  ! ' + msg + ' Accepted because of --allow-young.')
    else:
        print(f'  = --ref {ref[:7]} is {age} days old')


def remove(name, dry):
    data = load()
    before = len(data['skills'])
    data['skills'] = [s for s in data['skills'] if s['name'] != name]
    if len(data['skills']) == before:
        sys.exit(f'{name} is not in skills.json')
    if not dry:
        save(data)
    print(f"{'[dry-run] ' if dry else ''}removed {name} from skills.json.")
    print('Next: scripts/doctor.sh will flag the now-stale links; remove them with '
          f'`rm ~/.claude/skills/{name} ~/.agents/skills/{name}` (they are symlinks), then commit and push.')


def add(args):
    if not REPO.fullmatch(args.repo):
        sys.exit('repo must look like owner/name')
    if not NAME.fullmatch(args.skill):
        sys.exit('skill name must be lowercase letters, digits and dashes')
    if args.ref and not SHA.fullmatch(args.ref):
        sys.exit('--ref must be a full 40-character commit SHA')
    if not SAFE_DIR.fullmatch(args.skills_dir):
        sys.exit('--skills-dir must be a plain relative path inside the repo')
    data = load()
    if any(s['name'] == args.skill for s in data['skills']):
        sys.exit(f'{args.skill} is already in skills.json')

    owner, name = args.repo.lower().split('/')
    # Reuse an existing vendor for this exact repo; otherwise name it owner-repo so two
    # repos called "skills" (anthropics/skills, trailofbits/skills) never collide.
    vendor_name = next((k for k, v in data['vendors'].items() if v['repo'].lower() == args.repo.lower()), f'{owner}-{name}')
    vendor = data['vendors'].get(vendor_name)
    if vendor and vendor['repo'] != args.repo:
        sys.exit(f'vendor name {vendor_name} already used by {vendor["repo"]}')
    path = f'vendor/{vendor_name}'
    created_vendor = None
    if vendor and args.ref:
        sys.exit(f'{vendor_name} is already vendored at a pinned commit; --ref would be ignored. '
                 'Move the pin with the update flow (scripts/check-updates) instead.')
    if not vendor:
        ref = args.ref or pick_commit(args.repo, args.cooldown)
        if args.ref:
            check_ref_age(args.repo, args.ref, args.cooldown, args.allow_young)
        print(f'+ submodule {args.repo} -> {path} @ {ref[:7]}')
        if args.dry_run:
            print('[dry-run] stopping before any change.')
            return
        created_vendor = path     # from here on, any failure must undo the submodule
        try:
            git('submodule', 'add', f'https://github.com/{args.repo}', path)
            git('checkout', '-q', ref, cwd=ROOT / path)
            git('add', path)      # record the PINNED commit, not the branch head
        except subprocess.CalledProcessError as error:
            undo_vendor(created_vendor)
            sys.exit(f'git failed: {error.stderr.strip() or error}. Nothing was changed.')
        vendor = {'repo': args.repo, 'path': path, 'skills_dir': args.skills_dir, 'ref_prefix': f'{name}:'}
        data['vendors'][vendor_name] = vendor
    else:
        print(f'= reusing vendor {vendor_name} at {git("rev-parse", "--short", "HEAD", cwd=ROOT / path)}')

    entry = {'name': args.skill, 'source': 'vendor', 'vendor': vendor_name}
    if args.skills_dir != vendor['skills_dir']:
        entry['skills_dir'] = args.skills_dir     # e.g. one plugin folder per skill
    sdir = ROOT / vendor['path'] / args.skills_dir / args.skill
    md = sdir / 'SKILL.md'
    if not md.is_file():
        undo_vendor(created_vendor)
        sys.exit(f'no SKILL.md at {md.relative_to(ROOT)} at the pinned commit (wrong --skills-dir, or the repo '
                 'layout was different then?). Nothing was changed.')
    text = md.read_text(encoding='utf-8', errors='replace')
    fm = frontmatter(text)
    problems, warnings = [], []
    if fm.get('name') != args.skill:
        problems.append(f"frontmatter name is {fm.get('name')!r}, expected {args.skill!r}")
    if not fm.get('description'):
        problems.append('frontmatter has no description (agents could not decide when to use it)')
    for home in (Path.home() / '.claude/skills', Path.home() / '.agents/skills', Path.home() / '.codex/skills'):
        other = home / args.skill
        if other.exists() and not str(other.resolve()).startswith(str(ROOT)):
            warnings.append(f'name clash with existing {other}')
    enabled = {s['name'] for s in data['skills']} | {args.skill}
    refs = set(re.findall(re.escape(vendor['ref_prefix']) + r'([a-z0-9-]+)', text))
    if missing := sorted(refs - enabled):
        warnings.append('references skills that are not enabled: ' + ', '.join(missing))
    scripts = [p.name for p in sdir.rglob('*') if p.is_file() and (p.suffix in {'.sh', '.py', '.js', '.ts', '.cmd'} or p.stat().st_mode & 0o111)]
    if scripts:
        warnings.append('bundles code the agent may run, review it: ' + ', '.join(sorted(scripts)))
    for w in warnings:
        print('  ! ' + w)
    if problems:
        for p in problems:
            print('  ✘ ' + p)
        undo_vendor(created_vendor)
        sys.exit('not added. Nothing was changed.')
    if args.dry_run:
        print(f'[dry-run] would add {args.skill} to skills.json')
        return
    data['skills'].append(entry)
    save(data)
    print(f'+ {args.skill} added to skills.json ({len(text.splitlines())} lines in SKILL.md)')
    print('Next: read the SKILL.md, scripts/doctor.sh, ask the other agent to review, scripts/install.sh,')
    print(f'      then COMMIT AND PUSH:  git add -A && git commit -m "Add skill {args.skill}" && git push')
    print('      (public repo: check `git diff --cached` for secrets first)')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('repo', nargs='?')
    ap.add_argument('skill', nargs='?')
    ap.add_argument('--skills-dir', default='skills')
    ap.add_argument('--ref')
    ap.add_argument('--cooldown', type=int, default=14)
    ap.add_argument('--allow-young', action='store_true', help='accept a --ref younger than the cooldown')
    ap.add_argument('--remove', metavar='SKILL')
    ap.add_argument('--dry-run', action='store_true')
    args = ap.parse_args()
    if args.remove:
        return remove(args.remove, args.dry_run)
    if not (args.repo and args.skill):
        ap.error('need owner/repo and skill-name (or --remove NAME)')
    add(args)


if __name__ == '__main__':
    main()
